# ============================================================================
# SHADOWGRAPH — environment template (copy to .env and fill secrets)
# cp .env.example .env  (Windows: Copy-Item .env.example .env)
# .env is gitignored — NEVER commit real secrets.
# ============================================================================

# --- Runtime ---
# APP_MODE selects the infrastructure adapter bundle:
#   local      — SQLite + in-process graph + local task runner (default, no deps)
#   production — PostgreSQL + Neo4j + Redis/Celery (requires all three)
APP_MODE=local
DEMO_SEED=20260726                 # deterministic synthetic data seed
LOG_LEVEL=INFO

# --- Secrets (generate fresh values locally) ---
SECRET_KEY=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- PostgreSQL (required only when APP_MODE=production) ---
POSTGRES_USER=shadowgraph
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=shadowgraph
# Override for local PostgreSQL (non-Docker):
# DATABASE_URL=postgresql+psycopg://shadowgraph:change-me-strong-password@localhost:5432/shadowgraph

# --- Neo4j (required only when APP_MODE=production or GRAPH_BACKEND=neo4j) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-neo4j-password
# Override for local Neo4j (non-Docker):
# NEO4J_URI=bolt://localhost:7687

# --- Redis (required only when APP_MODE=production or TASK_BACKEND=celery) ---
# Override for local Redis (non-Docker):
# REDIS_URL=redis://localhost:6379/0

# --- API / Frontend ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
DB_ECHO=false

# --- Correlation weights (JSON) ---
# Defaults: PGP 30 · Wallet 25 · Handle 15 · Infrastructure 15 · Stylometry 10 · Behavior 5
CORRELATION_WEIGHTS={"pgp":30,"wallet":25,"handle":15,"infrastructure":15,"stylometry":10,"behavior":5}

# --- Demo accounts (bootstrap; role-aware) ---
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=change-me-demo-password
DEMO_ANALYST_USERNAME=demo_analyst
DEMO_ANALYST_PASSWORD=change-me-demo-password
